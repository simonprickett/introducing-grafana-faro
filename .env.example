# Copy to .env and edit. Everything here is optional - the defaults suit a local LGTM stack.

# --- Frontend (Grafana Faro) ---------------------------------------------------
# Faro collector URL, as reachable from the BROWSER.
#   Local (Alloy faro.receiver):  http://localhost:12347/collect
#   Grafana Cloud:                the collector URL from Frontend Observability -> Web SDK config
# Set to an empty string to disable Faro entirely.
FARO_URL=http://localhost:12347/collect
FARO_APP_NAME=coffee-cart-frontend
FARO_APP_VERSION=1.0.0
FARO_APP_ENV=local

# Where the browser reaches the API, and the frontend origin the API should allow (CORS).
API_URL=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:8080

# --- Backend ---------------------------------------------------------------------
# Which backend implementation to run: the name of a folder under ./backend.
# Every implementation exposes the same API (see backend/README.md).
BACKEND=nodejs

# --- Backend (OpenTelemetry) ---------------------------------------------------
OTEL_SERVICE_NAME=coffee-cart-backend
# Local LGTM stack running on the host (OTLP/HTTP):
OTEL_EXPORTER_OTLP_ENDPOINT=http://host.docker.internal:4318
# Grafana Cloud example (use the OTLP gateway endpoint and an access token from your stack):
#   OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-<zone>.grafana.net/otlp
#   OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64 of instanceID:token>
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=local

# --- App -----------------------------------------------------------------------
# ISO 4217 code (GBP, EUR, USD, JPY...). Prices are NOT converted - the same numbers are just
# shown in the chosen currency (450 is 4.50 for GBP, but 450 for JPY, which has no decimals).
CURRENCY=GBP
# Stock per product. Empty keeps the seed file's values (25 each, no restocking until a restart).
# Set it high (e.g. 100000) when running the traffic generator, or products sell out.
PRODUCT_STOCK=
