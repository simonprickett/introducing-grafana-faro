# GRAFANA CLOUD settings: the app runs locally but sends its telemetry to Grafana Cloud.
# Copy to .env.cloud (git ignored) and fill in the three values marked REQUIRED, then run
# ./start.sh cloud. The local stack in observability/ is not needed in this mode.
# Never commit .env.cloud: it contains an access token.

# --- Frontend (Grafana Faro) ---------------------------------------------------
# REQUIRED. The collector URL from Grafana Cloud: Frontend Observability -> your app -> Web SDK
# configuration. It looks like https://faro-collector-prod-<region>.grafana.net/collect/<app key>
# In the same place, add the frontend's origin (http://localhost:8080) to the app's allowed origins,
# or the browser's requests are blocked by CORS.
FARO_URL=<paste the Faro collector URL>
FARO_APP_NAME=coffee-cart-frontend
FARO_APP_VERSION=1.0.0
FARO_APP_ENV=cloud
# Records session replays, to watch back in Frontend Observability. Set to false to switch it off.
FARO_REPLAY=true

# Where the browser reaches the API, and the frontend origin the API should allow (CORS).
API_URL=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:8080

# --- Backend ---------------------------------------------------------------------
BACKEND=nodejs

# --- Backend (OpenTelemetry) ---------------------------------------------------
OTEL_SERVICE_NAME=coffee-cart-backend
# REQUIRED. The OTLP endpoint and credentials, from your stack's OpenTelemetry connection page
# (Connections -> OpenTelemetry, or grafana.com -> your stack -> OpenTelemetry -> Configure).
#   Endpoint:  https://otlp-gateway-<zone>.grafana.net/otlp
#   Header:    Authorization=Basic <base64 of "instanceID:token">   (NOT the raw token: printf 'ID:TOKEN' | base64)
OTEL_EXPORTER_OTLP_ENDPOINT=<paste the OTLP endpoint>
OTEL_EXPORTER_OTLP_HEADERS=<paste the Authorization header, e.g. Authorization=Basic abc123>
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=cloud

# --- Source maps (optional) ------------------------------------------------------
# A Cloud access policy token with the sourcemaps:read, sourcemaps:write, sourcemaps:delete and
# stacks:read scopes. ./start.sh cloud uses it (via observability/upload-sourcemaps-cloud.sh) to
# upload the source maps, so errors in Grafana Cloud show original file names and lines. Without
# it the upload is skipped. Not used by the app itself.
FARO_SOURCEMAP_TOKEN=<paste an access policy token with sourcemaps scopes>

# --- App -----------------------------------------------------------------------
CURRENCY=GBP
PRODUCT_STOCK=
